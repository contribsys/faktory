<%
package webui

import (
  "net/http"
  "runtime"

  "github.com/contribsys/faktory/client"
)

func ego_debug(w io.Writer, req *http.Request) {
  stats := ctx(req).Store().Stats(req.Context())
  var m runtime.MemStats
  runtime.ReadMemStats(&m)
  rdata, rtt := redis_info(req)
%>
<% ego_layout(w, req, func() { %>

<h3><%= t(req, "Debugging") %></h3>
<div class="table-responsive">
  <table class="error table table-bordered table-striped table-light">
    <tbody>
      <tr>
        <th><%= t(req, "Locale") %></th>
        <td>
          <select name="locales" id="faktory_locale" onchange="saveLocale(this.value)">
            <% sortedLocaleNames(req, func(locale string, current bool) { %>
              <option value="<%= locale %>" <% if current { %> selected <% } %> > <%= locale %> </option>
            <% }) %>
          </select>
          <span style="font-size: small">
            Want to help us improve the translations?
            <a href="https://github.com/contribsys/faktory/tree/main/webui/static/locales">Submit a PR</a>.
          </span>
        </td>
    </tr>
    <tr>
      <th><%= t(req, "Version") %></th>
      <td><%= client.Name %> <%= client.Version %></td>
    </tr>
    <tr>
    <th><%= t(req, "Data Location") %></th>
      <td><%= stats["name"] %></td>
    </tr>
    <tr>
      <th><%= t(req, "Runtime") %></th>
      <td>Goroutines: <%= runtime.NumGoroutine() %>, CPUs: <%= runtime.NumCPU() %></td>
    </tr>
    <tr>
      <th><%= t(req, "Memory") %></th>
      <td>
        Alloc (KB): <%= m.Alloc / 1024 %><br/>
        Live Objects: <%= m.Mallocs - m.Frees %>
        <% if amt := client.RssKb(); amt != 0 { %>
        <br/>RSS: <%= displayRss(amt) %>
        <% } %>
      </td>
    </tr>
    <tr>
      <th><%= t(req, "GC") %></th>
      <td>
        PauseTotal (µs): <%= m.PauseTotalNs / 1000 %><br/>
        NumGC: <%= m.NumGC %>
      </td>
    </tr>
    <tr>
      <th>
        <%= t(req, "Redis RTT") %>
        <a href="https://github.com/contribsys/faktory/wiki/Storage#rtt"><span class="info-circle" title="Click to learn more about RTT">?</span></a>
      </th>
      <td class="fw-bold text-<%= category_for_rtt(rtt) %>">
        <%= rtt %> µs
      </td>
    </tr>
  </tbody>
</table>
</div>

<h3><%= t(req, "Connections") %></h3>
<div class="table-responsive">
  <table class="connections table table-hover table-bordered table-striped table-light">
    <thead>
      <th><%= t(req, "Name") %></th>
      <th><%= t(req, "Address") %></th>
      <th><%= t(req, "ID") %></th>
      <th><%= t(req, "Started") %></th>
      <th><%= t(req, "Connections") %></th>
    </thead>
    <% total := 0 %>
    <% for _, cc := range ctx(req).Server().ClientConnections() { %>
      <% total += cc.Connections %>
      <tr>
        <td>
          <% if cc.Hostname != "" || cc.Pid != 0 { %>
            <code><%= cc.Hostname %>:<%= cc.Pid %></code>
          <% } %>
          <% if cc.IsConsumer() { %>
            <span class="badge bg-success">worker</span>
          <% } else { %>
            <span class="badge bg-secondary">client</span>
          <% } %>
          <% for _, label := range cc.Labels { %>
            <span class="badge bg-primary"><%= label %></span>
          <% } %>
        </td>
        <td><code><%= cc.Address %></code></td>
        <td><code><%= cc.Wid %></code></td>
        <td><%= Timeago(cc.Since) %></td>
        <td><%= cc.Connections %></td>
      </tr>
    <% } %>
    <tfoot>
      <tr>
        <th colspan="4"><%= t(req, "Total") %></th>
        <th><%= total %></th>
      </tr>
    </tfoot>
  </table>
</div>

<h3><%= t(req, "Redis Info") %></h3>
<pre>
<%= rdata %>
</pre>

<h3><%= t(req, "Disk Usage") %></h3>
<pre>
<code>&gt; df -h</code>
<%= df_h() %>
</pre>

<% }) %>
<% } %>
